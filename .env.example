# Local Docker Compose only. Copy to .env and replace every placeholder.
MYSQL_DATABASE=hireforge
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-password
DB_USERNAME=hireforge
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-base64-encoded-32-random-bytes
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CORS_ALLOWED_ORIGINS=http://localhost:8081
WEB_PORT=8081
