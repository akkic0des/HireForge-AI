# Backend environment reference. The application reads process environment variables;
# Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/hireforge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hireforge
DB_PASSWORD=replace-locally
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JWT_SECRET=replace-with-base64-encoded-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONNECT_TIMEOUT_MS=3000
GROQ_READ_TIMEOUT_MS=45000
